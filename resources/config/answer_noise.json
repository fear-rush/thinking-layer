{
  "metadata": {
    "description": "Corpus-backed legal boilerplate classification for answer composition. Used first for audit, then for answer ranking.",
    "calibrated": false
  },
  "explicit_request_terms": {
    "legal_preamble": [
      "dengan rahmat",
      "preambule",
      "pembukaan"
    ],
    "consideration": [
      "menimbang",
      "pertimbangan",
      "konsiderans",
      "latar belakang penerbitan"
    ],
    "legal_basis_reference": [
      "mengingat",
      "dasar hukum",
      "rujukan undang-undang",
      "landasan hukum"
    ],
    "enactment": [
      "memutuskan",
      "menetapkan",
      "amar putusan",
      "penetapan"
    ],
    "promulgation": [
      "lembaran negara",
      "tambahan lembaran negara",
      "diundangkan",
      "ditetapkan di",
      "tanggal berlaku"
    ],
    "letter_intro": [
      "sehubungan dengan amanat",
      "yth direksi",
      "surat edaran"
    ]
  },
  "categories": {
    "legal_preamble": {
      "description": "Opening title/regulator/preamble text, usually first-page material before operative rules.",
      "patterns": [
        "DENGAN\\s+RAHMAT\\s+TUHAN\\s+YANG\\s+MAHA\\s+ESA",
        "^(?:SALINAN\\s+)?PERATURAN\\s+(?:OTORITAS\\s+JASA\\s+KEUANGAN|BANK\\s+INDONESIA|ANGGOTA\\s+DEWAN\\s+GUBERNUR)(?:\\s+REPUBLIK\\s+INDONESIA)?\\s+NOMOR\\b",
        "^(?:SALINAN\\s+)?SURAT\\s+EDARAN\\s+(?:OTORITAS\\s+JASA\\s+KEUANGAN|BANK\\s+INDONESIA)(?:\\s+REPUBLIK\\s+INDONESIA)?\\s+NOMOR\\b",
        "^(?:SALINAN\\s+)?KEPUTUSAN\\s+(?:DEWAN\\s+KOMISIONER\\s+OTORITAS\\s+JASA\\s+KEUANGAN|GUBERNUR\\s+BANK\\s+INDONESIA|KETUA\\s+BAPEPAM|KETUA\\s+BADAN\\s+PENGAWAS\\s+PASAR\\s+MODAL)\\s+NOMOR\\b",
        "^(?:OTORITAS\\s+JASA\\s+KEUANGAN|BANK\\s+INDONESIA)\\s+REPUBLIK\\s+INDONESIA"
      ],
      "answer_policy": "reject_by_default"
    },
    "consideration": {
      "description": "Menimbang/konsiderans material that explains reasons but usually does not state operative obligations.",
      "patterns": [
        "\\bMenimbang\\s*:",
        "\\bkonsiderans\\b"
      ],
      "answer_policy": "reject_by_default"
    },
    "legal_basis_reference": {
      "description": "Mengingat/statutory reference lists that cite enabling laws rather than the answer itself.",
      "patterns": [
        "\\bMengingat\\s*:"
      ],
      "answer_policy": "reject_by_default"
    },
    "enactment": {
      "description": "MEMUTUSKAN/Menetapkan enactment bridge text before substantive articles.",
      "patterns": [
        "\\bMEMUTUSKAN\\s*:",
        "\\bMenetapkan\\s*:"
      ],
      "answer_policy": "reject_by_default"
    },
    "promulgation": {
      "description": "Promulgation/signature/state-gazette material usually found near closing pages.",
      "patterns": [
        "Lembaran\\s+Negara",
        "Tambahan\\s+Lembaran\\s+Negara",
        "\\bDiundangkan\\s+di\\b",
        "\\bDitetapkan\\s+di\\b",
        "\\bMENTERI\\s+HUKUM\\s+DAN\\s+HAK\\s+ASASI\\s+MANUSIA\\b"
      ],
      "answer_policy": "reject_by_default"
    },
    "letter_intro": {
      "description": "OJK/BI circular-letter introductory material before concrete provisions.",
      "patterns": [
        "Sehubungan\\s+dengan\\s+amanat",
        "\\bYth\\.?\\s+(?:Direksi|Pengurus|Dewan\\s+Komisioner)",
        "\\bdi\\s+tempat\\b.*\\bSALINAN\\s+SURAT\\s+EDARAN\\b"
      ],
      "answer_policy": "reject_by_default"
    },
    "substantive": {
      "description": "Default category when no boilerplate category matches.",
      "patterns": [],
      "answer_policy": "allow"
    }
  },
  "ranking": {
    "default_reject_penalty": -100.0,
    "category_penalty": {
      "legal_preamble": -120.0,
      "consideration": -100.0,
      "legal_basis_reference": -90.0,
      "enactment": -100.0,
      "promulgation": -120.0,
      "letter_intro": -90.0,
      "substantive": 0.0
    }
  },
  "audit": {
    "max_examples_per_category": 8,
    "example_chars": 360
  }
}
